{
  "name": "peak-local-runner",
  "private": true,
  "version": "0.1.0",
  "description": "Local runner for PEAK product data and Git sync",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "start": "node runner/server.mjs",
    "dev": "node runner/server.mjs",
    "electron": "electron .",
    "electron:dev": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ca.launchcanada.peak",
    "productName": "PEAK",
    "files": [
      "app/**/*",
      "electron/**/*",
      "runner/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
